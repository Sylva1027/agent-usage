+test("simultaneous callers keep bounded batches, then independent reads hash afresh", WINDOWS, async (t) => {
+  const f = await fixture(t);
+  await f.sync();
+  const before = f.hashes().length;
+  writeFileSync(f.admission, "3");
+  const results = await Promise.all(
+    ["all", "week", "today"].map((preset) => f.client.dashboard({ ...FILTERS, preset }, { includeDetails: false })),
+  );
+  const after = f.hashes().length;
+  assert.equal(after, before, "all three callers were admitted before the first query dispatch");
+  assert.equal(new Set(results.map((row) => row.status.fingerprint)).size, 1);
+  assert.equal(
+    results[0].summary.totals.total,
+    f.expectedFacts.reduce((sum, row) => sum + row.total, 0),
+  );
+  assertReleased(f);
+  await f.client.dashboard(FILTERS, { includeDetails: false });
+  assert.equal(f.hashes().length - after, 4, "a new batch revalidates both archive packages");
+  assertReleased(f);
+  assertLeasesClosed(f.rows());
+});
+
+test("late arrivals form a separate finite batch and share its fresh verification", WINDOWS, async (t) => {
+  const f = await fixture(t);
+  await f.sync();
+  writeFileSync(f.blockDashboard, "pause the admitted reader");
+  const first = f.client.dashboard(FILTERS, { includeDetails: false });
+  t.after(() => {
+    try {
+      writeFileSync(f.resumeDashboard, "resume");
+    } catch (error) {
+      if (error.code !== "ENOENT") throw error;
+    }
+  });
+  await until(() => f.rows().some((row) => row.kind === "dashboard-blocked"), "first reader enters its batch");
+  const before = f.hashes().length;
+  writeFileSync(f.admission, "2");
+  const late = ["week", "today"].map((preset) => f.client.dashboard({ ...FILTERS, preset }, { includeDetails: false }));
+  await until(() => f.requests.filter((row) => row.type === "dashboard").length === 3, "late requests reach IPC");
+  await delay(50);
+  writeFileSync(f.resumeDashboard, "resume");
+  await Promise.all([first, ...late]);
+  assert.equal(f.hashes().length - before, 4, JSON.stringify(f.rows().filter((row) => row.kind === "batch-guard")));
+  assertReleased(f);
+  assertLeasesClosed(f.rows());
+});
+
+test("an external commit invalidates remaining batch members without suppressing SHA", WINDOWS, async (t) => {
+  const f = await fixture(t);
+  await f.sync();
+  writeFileSync(f.blockDashboard, "pause before the first query");
+  const before = f.hashes().length;
+  const reads = ["all", "week", "today"].map((preset) =>
+    f.client.dashboard({ ...FILTERS, preset }, { includeDetails: false }),
+  );
+  t.after(() => {
+    try {
+      writeFileSync(f.resumeDashboard, "resume");
+    } catch (error) {
+      if (error.code !== "ENOENT") throw error;
+    }
+  });
+  await until(() => f.rows().some((row) => row.kind === "dashboard-blocked"), "reader is paused");
+  const writer = new DatabaseSync(f.options.databaseFile);
+  try {
+    writer.exec("CREATE TABLE lifecycle_external_commit(value INTEGER)");
+  } finally {
+    writer.close();
+  }
+  writeFileSync(f.resumeDashboard, "resume");
+  const results = await Promise.all(reads);
+  assert.equal(
+    results[0].summary.totals.total,
+    f.expectedFacts.reduce((sum, row) => sum + row.total, 0),
+  );
+  assert.ok(f.hashes().length - before >= 4, "later members cannot retain a pre-commit acquisition guard");
+  assertReleased(f);
+  assertLeasesClosed(f.rows());
+});
+
