diff --git a/packages/core/test/session-model-transport-receive.test.ts b/packages/core/test/session-model-transport-receive.test.ts
new file mode 100644
index 0000000..3fc5d81
--- /dev/null
+++ b/packages/core/test/session-model-transport-receive.test.ts
@@ -0,0 +1,87 @@
+import { expect, test } from "bun:test"
+import { AIError } from "@opencode/ai"
+import {
+  WebSocketTransport,
+  type ChannelObservation,
+  type WebSocketChannelExchange,
+  type WebSocketConnector,
+  type WebSocketReceive,
+} from "@opencode/ai/route"
+import { SessionModelTransport } from "@opencode/core/session/model-transport"
+import { Session } from "@opencode/schema/session"
+import { Effect, Stream } from "effect"
+import { Headers } from "effect/unstable/http"
+
+test("keeps native receive batches through a slow loopback WebSocket hook", async () => {
+  const session = Session.ID.make("ses_transport_receive")
+  const connector: WebSocketConnector = {
+    open: (input) => Effect.suspend(() => WebSocketTransport.fromWebSocket(new globalThis.WebSocket(input.url), input)),
+  }
+
+  await Effect.runPromise(
+    Effect.gen(function* () {
+      const server = yield* Effect.acquireRelease(
+        Effect.sync(() =>
+          Bun.serve({
+            hostname: "127.0.0.1",
+            port: 0,
+            fetch(request, server) {
+              if (server.upgrade(request)) return
+              return new Response("WebSocket upgrade required", { status: 426 })
+            },
+            websocket: {
+              message(socket, message) {
+                if (message !== "create") return
+                socket.send("first")
+                socket.send("second")
+                setTimeout(() => socket.send("third"), 25)
+              },
+            },
+          }),
+        ),
+        (server) => Effect.promise(() => server.stop(true)),
+      )
+      const seen: Array<{ frame: string; receive?: WebSocketReceive }> = []
+      let observations = 0
+      const exchange: WebSocketChannelExchange = {
+        id: "receive-batch",
+        connect: {
+          url: server.url.toString().replace(/^http/, "ws"),
+          headers: Headers.empty,
+        },
+        fallback: () => Stream.empty,
+        driver: {
+          create: () => Effect.succeed({ message: "create", mode: "full" }),
+          observe: (_create, frame): Effect.Effect<ChannelObservation, AIError> =>
+            Effect.sync(() => {
+              observations++
+              return observations === 3 ? { type: "completed", frame } : { type: "frame", frame }
+            }),
+        },
+      }
+      const transport = yield* SessionModelTransport.Service
+      const execution = yield* transport
+        .bind(session, {
+          receive: (frame, receive) =>
+            Effect.sleep("20 millis").pipe(
+              Effect.tap(() => Effect.sync(() => seen.push({ frame, receive }))),
+              Effect.as(frame),
+            ),
+        })
+        .execute(exchange)
+      const frames = Array.from(yield* Stream.runCollect(execution.frames))
+
+      expect(frames).toEqual(["first", "second", "third"])
+      expect(seen.map((item) => item.frame)).toEqual(["first", "second", "third"])
+      const first = seen[0]?.receive
+      const second = seen[1]?.receive
+      const third = seen[2]?.receive
+      if (!first || !second || !third) throw new Error("Expected native receive metadata")
+      expect(first.clock).toBe("monotonic")
+      expect(second.atMs).toBe(first.atMs)
+      expect(second.batchId).toBe(first.batchId)
+      expect(third.batchId).not.toBe(first.batchId)
+      expect(third.atMs).toBeGreaterThan(first.atMs)
+    }).pipe(Effect.provide(SessionModelTransport.makeLayer(connector)), Effect.scoped),
+  )
+})
