+        expect(frames).toEqual(["first:tapped", "done:tapped"])
+        expect(seen).toEqual([
+          { frame: "first", receive: first },
+          { frame: "done", receive: second },
+        ])
+        expect(seen[0]?.receive).toBe(first)
+        expect(seen[1]?.receive).toBe(second)
       }),
     )
   })
