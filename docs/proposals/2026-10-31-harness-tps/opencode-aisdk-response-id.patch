+it.effect("persists the response ID from the same AI SDK stream without replacing provider metadata", () =>
+  Effect.gen(function* () {
+    const aisdk = yield* AISDK.Service
+    yield* aisdk.hook.sdk((event) => {
+      event.sdk = {
+        languageModel: () =>
+          streamModel([
+            {
+              type: "response-metadata",
+              id: "chatcmpl-response-1",
+              modelId: "api-model",
+              timestamp: new Date(0),
+            },
+            { type: "text-start", id: "text-0" },
+            { type: "text-delta", id: "text-0", delta: "Complete" },
+            { type: "text-end", id: "text-0" },
+            {
+              type: "finish",
+              finishReason: { unified: "stop", raw: "stop" },
+              usage,
+              providerMetadata: {
+                "test-provider": { reasoning: "opaque", usage: { tier: "priority" } },
+                other: { retained: true },
+              },
+            },
+          ]),
+      }
+    })
+
+    const resolved = yield* aisdk.model(model("@ai-sdk/openai-compatible"))
+    const response = yield* LLMClient.generate(LLM.request({ model: resolved, prompt: "Hello" })).pipe(
+      Effect.provide(client),
+    )
+    const stepFinish = response.events.find(LLMEvent.is.stepFinish)
+    const finish = response.events.find(LLMEvent.is.finish)
+    if (!stepFinish || !finish) return yield* Effect.die("Expected step and terminal finish events")
+
+    for (const event of [stepFinish, finish]) {
+      expect(event.providerMetadata).toEqual({
+        "test-provider": {
+          responseId: "chatcmpl-response-1",
+          reasoning: "opaque",
+          usage: { tier: "priority" },
+        },
+        other: { retained: true },
+      })
+    }
+    expect(stepFinish?.usage).toMatchObject({ inputTokens: 1, outputTokens: 1 })
+    expect(finish?.usage).toMatchObject({ inputTokens: 1, outputTokens: 1 })
+  }),
+)
+
+it.effect("persists the Chat Completions response ID from the real compatible provider parser", () =>
+  Effect.gen(function* () {
+    const aisdk = yield* AISDK.Service
+    const responseId = "chatcmpl-compatible-parser-response"
+    const sse = [
+      `data: ${JSON.stringify({
+        id: responseId,
+        object: "chat.completion.chunk",
+        created: 0,
+        model: "api-model",
+        choices: [{ index: 0, delta: { role: "assistant", content: "Complete" }, finish_reason: null }],
+      })}`,
+      "",
+      `data: ${JSON.stringify({
+        id: responseId,
+        object: "chat.completion.chunk",
+        created: 0,
+        model: "api-model",
+        choices: [{ index: 0, delta: {}, finish_reason: "stop" }],
+        usage: { prompt_tokens: 1, completion_tokens: 1, total_tokens: 2 },
+      })}`,
+      "",
+      "data: [DONE]",
+      "",
+    ].join("\n")
+    let requests = 0
+    yield* aisdk.hook.sdk((event) => {
+      event.sdk = createOpenAICompatible({
+        ...event.options,
+        name: String(event.options.name),
+        baseURL: "https://compatible.example/v1",
+      })
+    })
+
+    const resolved = yield* aisdk.model(
+      model("@ai-sdk/openai-compatible", {
+        baseURL: "https://compatible.example/v1",
+        fetch: async () => {
+          requests++
+          return new Response(sse, { headers: { "content-type": "text/event-stream" } })
+        },
+      }),
+    )
+    const response = yield* LLMClient.generate(LLM.request({ model: resolved, prompt: "Hello" })).pipe(
+      Effect.provide(client),
+    )
+    const finishEvents = response.events.filter((event) => event.type === "step-finish" || event.type === "finish")
+
+    expect(requests).toBe(1)
+    expect(finishEvents).toHaveLength(2)
+    for (const event of finishEvents) {
+      expect(event.providerMetadata?.["test-provider"]).toMatchObject({ responseId })
+    }
+  }),
+)
